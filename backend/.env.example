# Copie este archivo como backend/.env y complete los valores. Nunca suba el archivo .env a GitHub.

# Supabase (Project Settings → API)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_KEY=clave-del-proyecto

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=clave-de-gemini
# Opcionales: modelo principal y de respaldo
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_MODEL_RESPALDO=gemini-flash-latest

# MLflow en DagsHub (opcional: sin token la API funciona, pero no registra en MLflow)
MLFLOW_TRACKING_PASSWORD=token-de-dagshub
DAGSHUB_REPO_OWNER=Marcelo-CC
DAGSHUB_REPO_NAME=Taller-de-Proyectos-Software

# Nivel de registro: DEBUG, INFO, WARNING o ERROR
LOG_LEVEL=INFO
